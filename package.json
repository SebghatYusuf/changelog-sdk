{
  "name": "changelog-sdk",
  "version": "1.3.1",
  "private": false,
  "type": "module",
  "description": "Framework-agnostic changelog core with Next.js, React, Vue, Express adapter and MongoDB adapter",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./core": {
      "types": "./dist/esm/core/index.d.ts",
      "import": "./dist/esm/core/index.js",
      "require": "./dist/cjs/core/index.js",
      "default": "./dist/esm/core/index.js"
    },
    "./next": {
      "types": "./dist/esm/next/index.d.ts",
      "import": "./dist/esm/next/index.js",
      "default": "./dist/esm/next/index.js"
    },
    "./mongoose": {
      "types": "./dist/esm/mongoose/index.d.ts",
      "import": "./dist/esm/mongoose/index.js",
      "require": "./dist/cjs/mongoose/index.js",
      "default": "./dist/esm/mongoose/index.js"
    },
    "./nuxt": {
      "types": "./dist/esm/nuxt/index.d.ts",
      "import": "./dist/esm/nuxt/index.js",
      "require": "./dist/cjs/nuxt/index.js",
      "default": "./dist/esm/nuxt/index.js"
    },
    "./express": {
      "types": "./dist/esm/express/index.d.ts",
      "import": "./dist/esm/express/index.js",
      "require": "./dist/cjs/express/index.js",
      "default": "./dist/esm/express/index.js"
    },
    "./react": {
      "types": "./dist/esm/react/index.d.ts",
      "import": "./dist/esm/react/index.js",
      "default": "./dist/esm/react/index.js"
    },
    "./vue": {
      "types": "./dist/esm/vue/index.d.ts",
      "import": "./dist/esm/vue/index.js",
      "require": "./dist/cjs/vue/index.js",
      "default": "./dist/esm/vue/index.js"
    },
    "./styles": "./dist/styles/changelog-ui.css"
  },
  "sideEffects": [
    "./dist/styles/changelog-ui.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths --resolve-full-extension .js && tsc -p tsconfig.build.cjs.json && mkdir -p dist/cjs dist/styles && printf '{\"type\":\"commonjs\"}\\n' > dist/cjs/package.json && cp lib/changelog-platform/styles/changelog-ui.css dist/styles/changelog-ui.css",
    "sync": "bun run build && cd example && bun install",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "dev": "cd example && bun run dev",
    "type-check": "tsc --noEmit",
    "check:mongo": "node scripts/check-mongodb.js",
    "hash:password": "node scripts/hash-password.js",
    "create:admin": "node scripts/create-admin-user.js",
    "example:install": "cd example && bun install",
    "example:dev": "cd example && bun run dev",
    "example:build": "cd example && bun run build",
    "vue-example:install": "cd vue-example && bun install",
    "vue-example:dev:server": "cd vue-example && bun run dev:server",
    "vue-example:dev:client": "cd vue-example && bun run dev:client",
    "vue-example:dev": "cd vue-example && bun run dev:server",
    "vue-example:build": "cd vue-example && bun run build",
    "vue-example:start": "cd vue-example && bun run start",
    "build:landing": "cd example && bun run export"
  },
  "keywords": ["changelog", "sdk", "framework-agnostic", "next.js", "typescript", "mongodb"],
  "author": "Sebghat Yusuf",
  "license": "MIT",
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "vue": ">=3.3.0",
    "ai": ">=4.0.0",
    "@ai-sdk/openai": ">=3.0.0",
    "@ai-sdk/google": ">=3.0.0",
    "ollama-ai-provider-v2": ">=3.0.0",
    "h3": ">=1.0.0",
    "express": ">=4.18.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "ollama-ai-provider-v2": {
      "optional": true
    },
    "h3": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "dependencies": {
    "mongoose": "^9.1.0",
    "zod": "^4.3.6",
    "bcryptjs": "^3.0.3",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.12",
    "dompurify": "^3.2.6"
  },
  "devDependencies": {
    "@ai-sdk/google": "^3.0.43",
    "@ai-sdk/openai": "^3.0.41",
    "@types/express": "^4.17.21",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "ai": "^6.0.116",
    "express": "^4.21.2",
    "h3": "^1.15.4",
    "next": "^16.1.6",
    "ollama-ai-provider-v2": "^3.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "vue": "^3.4.30"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
